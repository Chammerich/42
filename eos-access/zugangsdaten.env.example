# Kopieren nach "zugangsdaten.env" und ausfüllen. Diese Datei bleibt auf dem NAS und gehört nicht ins Git.
# Werte ohne Anführungszeichen direkt hinter das Gleichheitszeichen schreiben.
# Passwörter am besten nur aus Buchstaben und Ziffern (keine Zeichen wie $ # " oder Leerzeichen).

# Eigenes Netatmo-Konto nur für EOS Access, in der Home + Security-App als Mitglied eingeladen.
NETATMO_EMAIL=
NETATMO_PASSWORD=

# Anmeldung für die Verwaltung von EOS Access. Ein geändertes Passwort gilt nach dem nächsten Neustart.
EOS_ADMIN_USER=admin
EOS_ADMIN_PASSWORD=

# Zeitzone der Anlage.
TZ=Europe/Berlin

# --- Nur bei Bedarf ---
# Adresse, unter der Gäste die App erreichen; wird in Einladungslinks verwendet.
# Mit Tailscale Funnel: https://haustuer.<dein-tailnet>.ts.net
# Leer = die Adresse, unter der die Verwaltung gerade geöffnet ist.
EOS_PUBLIC_URL=
# Wenn das Konto mehrere Zuhause mit Geräten sieht.
EOS_HOME_ID=
# Wenn die Anlage mehrere Türöffner meldet oder die Haustür an einem Relais hängt.
EOS_DOOR_MODULE_ID=
