# Kopieren nach "tailscale.env". Diese Datei bleibt auf dem NAS und gehört nicht ins Git.

# Schlüssel aus der Tailscale-Verwaltung (Settings > Keys > Generate auth key).
# Er wird nur für die erste Anmeldung gebraucht; danach merkt sich der Container die Anmeldung.
TS_AUTHKEY=

# Name des Geräts im Tailnet und damit Beginn der öffentlichen Adresse:
# https://haustuer.<dein-tailnet>.ts.net
TS_HOSTNAME=haustuer
