# Kopieren nach "zugangsdaten.env" und ausfüllen. Diese Datei bleibt auf dem NAS und gehört nicht ins Git.
# Werte ohne Anführungszeichen direkt hinter das Gleichheitszeichen schreiben.
# Passwörter am besten nur aus Buchstaben und Ziffern (keine Zeichen wie $ # " oder Leerzeichen).

# Eigenes Netatmo-Konto nur für EOS Access (nicht das persönliche Konto),
# in der Home + Security-App als Mitglied des Zuhauses eingeladen.
NETATMO_EMAIL=
NETATMO_PASSWORD=

# Passwort für die Testkonsole im Browser (frei wählbar, Benutzername beliebig).
EOS_CONSOLE_PASSWORD=

# Zeitzone der Anlage.
TZ=Europe/Berlin

# Nur nötig, wenn das Konto mehrere Zuhause mit Geräten sieht.
EOS_HOME_ID=
